# Choose openai, anthropic, or gemini. LLM_API_KEY is used for the chosen provider.
LLM_PROVIDER=openai
LLM_API_KEY=

# Provider-specific keys can coexist, allowing a choice in the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.5-flash
